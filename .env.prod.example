# Локальный стек Docker + доступ извне через ngrok/cloudflared (см. TUNNEL_DEMO.md).

# На какой порт на этом ПК висит приложение для туннеля (frontend/nginx).
TUNNEL_INGRESS_PORT=8080

POSTGRES_USER=wellness
POSTGRES_PASSWORD=change_me_very_strong_password
POSTGRES_DB=wellness_prod
# Том Docker: wellness_pgdata_prod (не путать с wellness_pgdata у docker-compose.yml для dev).

JWT_SECRET=replace_with_at_least_32_characters_secret

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_password

# On first start set true once, then switch to false.
RUN_DB_SEED=true

# Отражает Origin — нужно для сменных URL (*.ngrok-free.app, *.trycloudflare.com). Отключите false только если знаете зачем.
CORS_REFLECT_REQUEST_ORIGIN=true

# Required for vLLM mode.
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
VLLM_MAX_MODEL_LEN=2048
VLLM_GPU_MEMORY_UTIL=0.6
HF_TOKEN=

# Optional for OpenAI-compatible providers that require an API key.
SENTIMENT_OPENAI_API_KEY=
SENTIMENT_OPENAI_JSON_MODE=true

# Optional tuning parameters for recommendation thresholds.
JOURNAL_PSYCHOLOGIST_LEVEL=0.72
JOURNAL_DISTRESS_STREAK_LEVEL=0.58
JOURNAL_SENTIMENT_STREAK_THRESHOLD=-0.6
JOURNAL_SENTIMENT_STREAK_LEN=3
JOURNAL_DISTRESS_STREAK_LEN=3
ANXIETY_HELP_LEVEL=70
ANXIETY_URGENT_LEVEL=85
DEPRESSION_HELP_LEVEL=65
DEPRESSION_URGENT_LEVEL=80
