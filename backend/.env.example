DATABASE_URL="postgresql://wellness:wellness@localhost:5432/wellness_dev?schema=public"
JWT_SECRET="change-me-in-production-min-32-chars-long-secret"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Дневник: heuristic (без сети) | openai — любой OpenAI-compatible API (/v1/chat/completions), например LM Studio или vLLM с Qwen.
SENTIMENT_PROVIDER=heuristic

# Пример: LM Studio → Load Qwen → локальный сервер, обычно порт 1234, Base URL заканчивается на /v1
# SENTIMENT_PROVIDER=openai
# SENTIMENT_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# SENTIMENT_OPENAI_MODEL=Qwen/Qwen2.5-3B-Instruct-GGUF
# SENTIMENT_OPENAI_API_KEY=

# Пороги (0–1), кроме JOURNAL_SENTIMENT_STREAK_THRESHOLD (−1…1)
JOURNAL_PSYCHOLOGIST_LEVEL=0.72
JOURNAL_DISTRESS_STREAK_LEVEL=0.58
JOURNAL_SENTIMENT_STREAK_THRESHOLD=-0.6
JOURNAL_SENTIMENT_STREAK_LEN=3
JOURNAL_DISTRESS_STREAK_LEN=3
