DATABASE_URL="postgresql://wellness:wellness@localhost:5432/wellness_dev?schema=public"
JWT_SECRET="OLESYA_SECRET_KEY_FOR_JWT_0123456789"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
# Полный Docker-стек + тунель: включается в compose (docker-compose.prod.yml); отражает Origin для ngrok/cloudflared (см. TUNNEL_DEMO.md).
# CORS_REFLECT_REQUEST_ORIGIN=true

# Дневник: heuristic (без сети) | openai — OpenAI-compatible POST /v1/chat/completions (vLLM в Docker, LM Studio и т.п.)
# SENTIMENT_PROVIDER=heuristic

# --- Вариант A: vLLM в Docker ---
# SENTIMENT_OPENAI_BASE_URL: порт как у VLLM_PORT в .env рядом с docker-compose.yml (по умолчанию 8000).
# SENTIMENT_OPENAI_MODEL: ДОЛЖНА быть ТА ЖЕ строка, что и VLLM_MODEL на сервере (см. /v1/models), иначе 404 "model does not exist".

SENTIMENT_PROVIDER=openai
SENTIMENT_OPENAI_BASE_URL=http://127.0.0.1:8000/v1
SENTIMENT_OPENAI_MODEL=Qwen/Qwen2.5-1.5B-Instruct
SENTIMENT_OPENAI_API_KEY=
SENTIMENT_OPENAI_JSON_MODE=true

# --- Вариант B: vLLM без Docker ---
# SENTIMENT_PROVIDER=openai
# SENTIMENT_OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# SENTIMENT_OPENAI_MODEL=Qwen/Qwen2.5-3B-Instruct
# SENTIMENT_OPENAI_API_KEY=
# SENTIMENT_OPENAI_JSON_MODE=true

# --- Вариант C: LM Studio (GGUF) ---
# SENTIMENT_PROVIDER=openai
# SENTIMENT_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# SENTIMENT_OPENAI_MODEL=Qwen/Qwen2.5-3B-Instruct-GGUF
# SENTIMENT_OPENAI_API_KEY=
# SENTIMENT_OPENAI_JSON_MODE=false

# Пороги (0–1), кроме JOURNAL_SENTIMENT_STREAK_THRESHOLD (−1…1)
JOURNAL_PSYCHOLOGIST_LEVEL=0.72
JOURNAL_DISTRESS_STREAK_LEVEL=0.58
JOURNAL_SENTIMENT_STREAK_THRESHOLD=-0.6
JOURNAL_SENTIMENT_STREAK_LEN=3
JOURNAL_DISTRESS_STREAK_LEN=3

# Пороги 0-100 для графиков самонаблюдения и рекомендаций обратиться за поддержкой
ANXIETY_HELP_LEVEL=70
ANXIETY_URGENT_LEVEL=85
DEPRESSION_HELP_LEVEL=65
DEPRESSION_URGENT_LEVEL=80

# Демо-администратор для seed
ADMIN_EMAIL=fafa@mail.ru
ADMIN_PASSWORD=sashasasha
